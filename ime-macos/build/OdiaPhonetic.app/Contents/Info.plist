<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>OdiaPhonetic</string>

    <!-- The bundle identifier MUST contain the literal substring "inputmethod".
         macOS uses this to recognise the bundle as an input method. -->
    <key>CFBundleIdentifier</key>
    <string>com.amritmohapatra.inputmethod.OdiaPhonetic</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Odia Phonetic</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Headless: no Dock icon, no menu bar, no windows of its own. -->
    <key>LSBackgroundOnly</key>
    <true/>

    <!-- IMK wiring. The connection name is read back by main.swift.
         InputMethodServerControllerClass must match the @objc name of the controller
         class, which is why OdiaInputController is declared @objc(OdiaInputController)
         rather than relying on Swift's module-qualified name. -->
    <key>InputMethodConnectionName</key>
    <string>OdiaPhonetic_Connection</string>
    <key>InputMethodServerControllerClass</key>
    <string>OdiaInputController</string>

    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Orya</string>
    </array>

    <key>ComponentInputModeDict</key>
    <dict>
        <key>tsInputModeListKey</key>
        <dict>
            <key>com.amritmohapatra.inputmethod.OdiaPhonetic.Odia</key>
            <dict>
                <key>TISInputSourceID</key>
                <string>com.amritmohapatra.inputmethod.OdiaPhonetic.Odia</string>
                <key>TISIntendedLanguage</key>
                <string>or</string>
                <key>tsInputModeCharacterRepertoireKey</key>
                <array>
                    <string>Orya</string>
                </array>
                <key>tsInputModeIsVisibleKey</key>
                <true/>
                <key>tsInputModeKeyEquivalentModifiersKey</key>
                <integer>0</integer>
                <key>tsInputModePrimaryInScriptKey</key>
                <true/>
                <!-- Classic Mac script code 12 = smOriya -->
                <key>tsInputModeScriptKey</key>
                <string>smOriya</string>
                <key>tsInputModeAlternateKey</key>
                <string>com.amritmohapatra.inputmethod.OdiaPhonetic.Odia</string>
            </dict>
        </dict>
        <key>tsVisibleInputModeOrderedArrayKey</key>
        <array>
            <string>com.amritmohapatra.inputmethod.OdiaPhonetic.Odia</string>
        </array>
    </dict>
</dict>
</plist>
