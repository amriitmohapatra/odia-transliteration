{
  "name": "odia-transliteration",
  "version": "0.1.0",
  "private": true,
  "description": "English -> Odia (ଓଡ଼ିଆ) phonetic transliteration: offline TypeScript engine, CLI and PWA.",
  "license": "MIT",
  "author": "Amrit Mohapatra",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "core",
    "cli",
    "web"
  ],
  "scripts": {
    "test": "npm run test --workspace @odia/core && vitest run --root Appv2 && vitest run --root lens && vitest run --root tools/assist && node docs/odia-simple.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "eval": "tsx tools/eval/run_eval.ts",
    "dev:web": "npm run dev --workspace @odia/web",
    "clean": "rm -rf core/dist cli/dist web/dist **/*.tsbuildinfo",
    "build:app": "npm run build:single --workspace @odia/web",
    "build:app:legacy": "npm run build:legacy --workspace @odia/web",
    "build:lens": "node lens/build.mjs --zip"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "^25.9.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "5.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
