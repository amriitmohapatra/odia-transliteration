{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    // NodeNext means relative imports must carry an explicit ".js" extension,
    // even in .ts source:  import { canonical } from "./normalize.js";
    // This is what lets cli/dist run under plain node with no bundler, and it
    // is also what Vite and JavaScriptCore both accept. The web workspace
    // overrides this to bundler resolution.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
